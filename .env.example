# LiteRealm Environment Configuration

# Google Gemini API key (optional). RAG uses it for cloud embeddings when Ollama is not set;
# otherwise it falls back to local sentence-transformers. RAG works either way.
# GEMINI_API_KEY=your-api-key-here

# Path to the Global Brain knowledge base (shared across all projects)
# Used by bootstrap scripts and DevContainer mounts.
# Default: ~/.agentbrain (Linux/macOS) or %USERPROFILE%\.agentbrain (Windows)
AGENTBRAIN_PATH=~/.agentbrain

# --- RAG embeddings (optional) ---
# Local Ollama embedding model. Pin it: a corpus built with one model cannot be
# queried with another (different vector dimension).
# OLLAMA_EMBED_MODEL=qwen3-embedding:8b

# Fail closed instead of silently falling back to another embedding model
# (Gemini / bge-m3 / MiniLM) when Ollama is unreachable during ingest.
# RAG_STRICT_EMBED=1

# --- RAG store (optional) ---
# Qdrant server. Unset -> local LanceDB in .ai/rag/db.
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=agentbrain_corpus_8b
# QDRANT_TIMEOUT=60
